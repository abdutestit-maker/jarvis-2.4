{
  "_comment": "Скопируйте этот файл в config/settings.json и заполните ключи. Пустой ключ = тир недоступен, совет мудрецов его пропустит.",

  "api_keys": {
    "deepseek": "",
    "kimi": "",
    "claude": "",
    "openrouter": ""
  },

  "api_endpoints": {
    "deepseek": "https://api.deepseek.com/v1",
    "kimi": "https://api.moonshot.ai/v1",
    "claude": "https://api.anthropic.com/v1",
    "openrouter": "https://openrouter.ai/api/v1"
  },

  "model_tiers": {
    "fast": "qwen-4b-local",
    "analyst": "qwen-4b-local",
    "coder": "qwen-4b-local",
    "architect": "qwen-4b-local"
  },

  "tier_providers": {
    "fast": "local",
    "analyst": "local",
    "coder": "local",
    "architect": "local"
  },

  "primary_brain": "fast",
  "offline_mode": true,
  "warmup_local_on_start": true,
  "auto_download_models": true,

  "local_model": {
    "gguf_path": "data/models/qwen3-4b-instruct-q5_k_m.gguf",
    "auto_profile": true,
    "draft_model_path": "",
    "speculative_decoding": false,
    "draft_max_tokens": 5,
    "native_tool_calling": true,
    "embedding_gguf_path": "",
    "n_gpu_layers": -1,
    "n_ctx": 4096,
    "n_threads": 0,
    "n_batch": 1024,
    "quantization": "Q5_K_M",
    "temperature": 0.6,
    "max_tokens": 512,
    "chat_format": null,
    "verbose": false
  },
  "local_coder_model": {
    "gguf_path": "",
    "n_gpu_layers": -1,
    "n_ctx": 8192,
    "n_threads": 0,
    "n_batch": 512,
    "quantization": "Q5_K_M",
    "temperature": 0.2,
    "max_tokens": 2048,
    "chat_format": null,
    "verbose": false
  },

  "voice": {
    "tts_enabled": true,
    "tts_always_on": true,
    "provider": "piper",
    "language": "ru",
    "voice": "ru_RU-dmitri-medium",
    "fallback": "none",
    "stt_enabled": false,
    "piper_model_path": "data/models/piper/ru_RU-dmitri-medium.onnx",
    "piper_binary_path": "piper",
    "speed": 1.0,
    "volume": 1.0,
    "piper_speaker_id": 0,
    "piper_length_scale": 1.0,
    "piper_noise_scale": 0.667,
    "piper_noise_w": 0.8,
    "piper_voices": [],
    "modes": {
      "normal": {"rate": 1.0, "volume": 1.0},
      "focused": {"rate": 1.03, "volume": 1.0},
      "quiet": {"rate": 0.96, "volume": 0.72},
      "urgent": {"rate": 1.04, "volume": 1.0},
      "amused": {"rate": 1.02, "volume": 0.95},
      "background": {"rate": 0.98, "volume": 0.85}
    }
  },

  "paths": {
    "data_dir": "data",
    "documents_dir": "data/documents",
    "memory_dir": "data/memory",
    "models_dir": "data/models",
    "logs_dir": "data/logs",
    "profile_dir": "data/profile",
    "graph_dir": "data/graph"
  },

  "persona": {
    "name": "АТЛАС",
    "address": "сэр",
    "persona_file": "persona/persona.md",
    "language": "ru"
  },

  "limits": {
    "short_memory_size": 20,
    "response_timeout_sec": 15,
    "proactive_cooldown_min": 30,
    "local_latency_target_sec": 1.5,
    "max_retries": 3,
    "rag_top_k": 3,
    "memory_top_k": 5,
    "max_action_iterations": 6
  },
  "latency_budgets": {
    "fast_p50_ms": 600,
    "fast_p95_ms": 1000,
    "fast_hard_max_ms": 1500,
    "deliberate_first_progress_p95_ms": 2500,
    "deliberate_p50_ms": 8000,
    "deliberate_p95_ms": 15000,
    "research_first_progress_p95_ms": 3000,
    "research_source_timeout_ms": 8000,
    "background_enqueue_p95_ms": 100
  },

  "stt": {
    "enabled": false,
    "model": "faster-whisper-small",
    "vad": "webrtc",
    "language": "auto",
    "hotkey_mode": "hold_ctrl_space"
  },
  "wake_word": {
    "enabled": false,
    "phrase": "ATLAS",
    "sensitivity": 0.5
  },
  "shadow": {
    "enabled": true,
    "auto_generate": true,
    "interval_sec": 300,
    "code_model_path": "data/models/Qwen3-1.7B-Q6_K.gguf"
  },
  "brain_policy": {
    "mode": "BALANCED",
    "prefer_local": true,
    "allow_cloud": false,
    "allow_sensitive_cloud": false,
    "background_allow_cloud": false,
    "max_fallbacks": 2,
    "failure_timeout_seconds": 3.0,
    "max_cost_tier": 3,
    "providers_path": "data/brain/providers.json"
  },
  "system_triggers": [],

  "logging": {
    "level": "INFO",
    "console": true,
    "max_bytes": 5242880,
    "backup_count": 5
  }
}
