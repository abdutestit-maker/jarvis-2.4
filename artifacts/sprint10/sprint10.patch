 def _safe_id(value: str) -> str:
     cleaned = re.sub(r"[^a-zA-Z0-9_.-]+", "_", value).strip("._")
     return cleaned[:100] or "capability"
+
+
+_OPERATOR_SECRET_KEYS = ("password", "passwd", "secret", "token", "api_key",
+                         "api key", "credential")
+
+
+def _operator_safe_mapping(value: dict[str, Any]) -> dict[str, Any]:
+    """Return a JSON-safe mapping with secret-shaped fields removed."""
+    from core.memory.secret_filter import sanitize_for_memory
+
+    result: dict[str, Any] = {}
+    for key, item in value.items():
+        label = str(key)
+        if any(secret in label.casefold() for secret in _OPERATOR_SECRET_KEYS):
+            continue
+        if isinstance(item, dict):
+            result[label] = _operator_safe_mapping(item)
+        elif isinstance(item, (list, tuple)):
+            result[label] = [
+                _operator_safe_mapping(entry) if isinstance(entry, dict)
+                else sanitize_for_memory(entry) if isinstance(entry, str)
+                else entry
+                for entry in item
+            ]
+        elif isinstance(item, str):
+            result[label] = sanitize_for_memory(item)
+        elif item is None or isinstance(item, (bool, int, float)):
+            result[label] = item
+        else:
+            result[label] = sanitize_for_memory(str(item))
+    return result
+
+
+def _flatten_mapping(value: dict[str, Any], prefix: str = "") -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, item in value.items():
+        path = f"{prefix}.{key}" if prefix else key
+        if isinstance(item, dict):
+            result.update(_flatten_mapping(item, path))
+        else:
+            result[path] = item
+    return result
