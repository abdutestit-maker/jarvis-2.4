-        os.replace(tmp, target)
-        _flush_directory(target.parent)
-    finally:
+    with _ATOMIC_LOCK:
+        target.parent.mkdir(parents=True, exist_ok=True)
+        fd, raw_tmp = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".tmp", dir=target.parent)
+        tmp = Path(raw_tmp)
         try:
-            tmp.unlink()
