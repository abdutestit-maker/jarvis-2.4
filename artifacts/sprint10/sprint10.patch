+        )
+        capability.tools = tools or capability.tools
+        capability.desired_state = safe_desired
+        capability.generalized_procedure = procedure
+        capability.record_result(success=True, duration=duration)
+        self.catalog.save(capability)
+
+        episode = CapabilityEpisode(
